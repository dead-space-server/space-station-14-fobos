<Control xmlns="https://spacestation14.io"
		xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
	<!-- Name and button -->
	<!-- DS14-start -->
	<PanelContainer Margin="5 5 0 5" StyleClasses="BackgroundDark">
			<!-- DS14-end -->
			<BoxContainer Orientation="Vertical" HorizontalExpand="True">
			<GridContainer Margin="5" Columns="2" MinSize="600 0">
				<Label Name="SetName" Text="Set" StyleClasses="highlight"></Label>
				<Button Margin="0 10" Name="SetButton" Text="Select" StyleClasses="OpenRight" Access="Public" HorizontalAlignment="Right"/>
			</GridContainer>
			<!-- DS14-start -->
			<controls:HLine StyleClasses="LowDivider" Thickness="1" Margin="0 5"/>
			<!-- DS14-end -->
			<!-- Icon and Description -->
			<GridContainer Margin="0 5" Columns="2">
				<TextureRect Name="Icon" Margin="10" Stretch="KeepAspectCentered"
							VerticalAlignment="Center" HorizontalAlignment="Right" MinSize="64 64"/>
				<Label Name="SetDescription" Text="Description"></Label>
			</GridContainer>
		</BoxContainer>
	</PanelContainer>
</Control>
