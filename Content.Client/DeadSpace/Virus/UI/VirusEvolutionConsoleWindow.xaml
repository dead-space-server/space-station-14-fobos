<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'virus-evolution-window-title'}"
               MinSize="750 500"
               SetSize="900 600">

    <TabContainer Name="MasterTabContainer">

        <!-- ================= EVOLUTION TAB ================= -->
        <BoxContainer Name="EvolutionTab"
                      Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True">

            <!-- CONTENTS -->
            <PanelContainer Name="EvolutionContents"
                            StyleClasses="Inset"
                            VerticalExpand="True"
                            Margin="5">

                <BoxContainer Orientation="Horizontal"
                              HorizontalExpand="True"
                              VerticalExpand="True">

                    <!-- Available symptoms -->
                    <PanelContainer MinWidth="220" Margin="5">
                        <BoxContainer Orientation="Vertical">
                            <Label Text="{Loc 'virus-evolution-available-symptoms'}" />
                            <ScrollContainer VerticalExpand="True">
                                <ItemList Name="AvailableSymptomsList"
                                          Access="Public"
                                          SelectMode="Single" />
                            </ScrollContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <!-- Center -->
                    <PanelContainer Margin="5"
                                    HorizontalExpand="True"
                                    VerticalExpand="True">
                        <BoxContainer Orientation="Vertical"
                                      VerticalExpand="True">
                            <Label Text="{Loc 'virus-evolution-description-header'}" />
                            <RichTextLabel Name="SymptomDescription"
                                           VerticalExpand="True"/>

                            <Label Name="MutationPointsLabel"/>
                            <Label Name="SymptomCostLabel"/>

                            <Button Name="BuySymptomButton"
                                    Access="Public"
                                    Text="{Loc 'virus-evolution-buy-button'}"
                                    Disabled="True"/>
                        </BoxContainer>
                    </PanelContainer>

                    <!-- Active symptoms -->
                    <PanelContainer MinWidth="220" Margin="5">
                        <BoxContainer Orientation="Vertical">
                            <Label Text="{Loc 'virus-evolution-active-symptoms'}" />
                            <ScrollContainer VerticalExpand="True">
                                <ItemList Name="ActiveSymptomsList"
                                          Access="Public"
                                          SelectMode="None" />
                            </ScrollContainer>
                        </BoxContainer>
                    </PanelContainer>

                </BoxContainer>
            </PanelContainer>

            <!-- DATASERVER MISSING -->
            <PanelContainer Name="EvolutionServerMissing"
                            StyleClasses="Inset"
                            VerticalExpand="True"
                            Margin="5">
                <Label HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Loc 'virus-evolution-dataserver-missing'}"/>
            </PanelContainer>

            <!-- DATASERVER FAR -->
            <PanelContainer Name="EvolutionServerFar"
                            StyleClasses="Inset"
                            VerticalExpand="True"
                            Margin="5">
                <Label HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Loc 'virus-evolution-dataserver-far'}"/>
            </PanelContainer>

        </BoxContainer>

        <!-- ================= WHITELIST TAB ================= -->
        <BoxContainer Name="WhitelistTab"
                      Orientation="Vertical"
                      VerticalExpand="True">

            <!-- CONTENTS -->
            <PanelContainer Name="WhitelistContents"
                            StyleClasses="Inset"
                            VerticalExpand="True"
                            Margin="5">

                <BoxContainer Orientation="Vertical"
                              Margin="5"
                              VerticalExpand="True">

                    <Label Text="{Loc 'virus-evolution-whitelist'}"/>

                    <ScrollContainer VerticalExpand="True">
                        <ItemList Name="BodyWhitelistList"
                                  Access="Public"
                                  SelectMode="Single"/>
                    </ScrollContainer>

                    <Button Name="BuyBodyButton"
                            Access="Public"
                            Text="{Loc 'virus-evolution-buy-body'}"
                            Disabled="True"/>
                </BoxContainer>

            </PanelContainer>

            <!-- SERVER MISSING -->
            <PanelContainer Name="WhitelistServerMissing"
                            StyleClasses="Inset"
                            VerticalExpand="True"
                            Margin="5">
                <Label HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Loc 'virus-evolution-dataserver-missing'}"/>
            </PanelContainer>

            <!-- SERVER FAR -->
            <PanelContainer Name="WhitelistServerFar"
                            StyleClasses="Inset"
                            VerticalExpand="True"
                            Margin="5">
                <Label HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Loc 'virus-evolution-dataserver-far'}"/>
            </PanelContainer>

        </BoxContainer>

    </TabContainer>
</DefaultWindow>

