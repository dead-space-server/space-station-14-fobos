<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:ui="clr-namespace:Robust.Client.UserInterface.Controls;assembly=Robust.Client"
                      Title="{Loc 'headshot-examine-title'}"
                      MinSize="400 500"
                      SetSize="500 600">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="10"
                  SeparationOverride="10">
        <PanelContainer MinSize="300 300"
                        MaxSize="500 500"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        Name="HeadshotContainer"
                        Visible="False">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1a1a1a"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextureRect Name="HeadshotTexture"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="KeepAspect"
                             MinSize="300 300"
                             MaxSize="500 500"
                             Visible="False"/>
                <ui:Label Name="HeadshotLoadingLabel"
                          Text="{Loc 'headshot-loading'}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visible="False"/>
            </BoxContainer>
        </PanelContainer>
        <PanelContainer HorizontalExpand="True"
                        VerticalExpand="True"
                        MinSize="0 100">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#2d2d2d"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="8">
                <ui:Label Text="{Loc 'headshot-flavor-text-label'}"
                          Margin="0 0 0 4"
                          StyleClasses="LabelHeading"/>
                <ui:RichTextLabel Name="FlavorTextLabel"
                                  HorizontalExpand="True"
                                  VerticalExpand="True"
                                  VerticalAlignment="Top"/>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
