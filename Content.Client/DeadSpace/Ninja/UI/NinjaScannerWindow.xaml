<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    MinSize="400 350"
    SetSize="400 350"
    Resizable="False"
    Title="{Loc 'ninja-scanner-window-title'}">
    <BoxContainer Orientation="Vertical" Margin="10 10 10 10" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal">
            <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="4 4 4 4">
                    <Label Text="{Loc 'ninja-scanner-window-targets'}"
                            HorizontalAlignment="Center"
                            StyleClasses="ConsoleHeading"
                            Modulate="#1bcc15"
                            Margin="0 0 0 4"
                            Align="Center"/>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <PanelContainer SetHeight="2" Margin="0 0 0 8">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1bcc15"/>
            </PanelContainer.PanelOverride>
        </PanelContainer>
        <BoxContainer Name="TargetsContainer" Orientation="Vertical" VerticalExpand="True">
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>