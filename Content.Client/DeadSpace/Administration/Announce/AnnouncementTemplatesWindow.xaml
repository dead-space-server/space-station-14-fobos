<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc admin-announce-templates-button}"
               MinWidth="400"
               MinHeight="320"
               SetSize="620 360"
               HeaderClass="DS14MenuHeader"
               TitleClass="DS14MenuTitle">
    <PanelContainer StyleClasses="DS14MenuFlatBody">
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      Margin="4">
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="TemplatesContainer"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              SeparationOverride="4"/>
            </ScrollContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>