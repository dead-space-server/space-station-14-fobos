<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               xmlns:shuttles="clr-namespace:Content.Client.Shuttles.UI"
               xmlns:pinpointer="clr-namespace:Content.Client.Pinpointer.UI"
               xmlns:bsa="clr-namespace:Content.Client.DeadSpace.BSAConsole"
               x:Class="Content.Client.DeadSpace.BSAConsole.BSAConsoleWindow"
               Title="Bluespace Artillery Console"
               MinWidth="700"
               MinHeight="500">
    <BoxContainer Orientation="Horizontal" Margin="4" SeparationOverride="4" VerticalExpand="True">

        <!-- LEFT PANEL: Status & Network -->
        <BoxContainer Orientation="Vertical" MinWidth="200" MaxWidth="220" SeparationOverride="4" Margin="0 0 4 0">
            <PanelContainer VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1a1a2eFF" BorderColor="#00d4ff" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="8">
                    <Label Text="CONTROL &amp; NETWORK" StyleClasses="LabelBig" FontColorOverride="#00d4ff" HorizontalAlignment="Center" />
                    <PanelContainer MinHeight="1" Margin="0 2">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#00d4ff" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>

                    <Label Text="Подключено к:" FontColorOverride="#888888" />
                    <Label Name="BSAConnectionLabel" Text="Не подключено" FontColorOverride="#FF4444" />

                    <PanelContainer MinHeight="1" Margin="0 4">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#333355" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>

                    <Label Text="СОСТОЯНИЕ ОРУДИЯ" StyleClasses="LabelBig" FontColorOverride="#00d4ff" HorizontalAlignment="Center" />
                    <PanelContainer Name="CooldownPanel" MinHeight="36">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#003300" BorderColor="#00FF00" BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <Label Name="CooldownLabel" Text="ГОТОВА К ЗАЛПУ" HorizontalAlignment="Center" VerticalAlignment="Center" FontColorOverride="#00FF00" />
                    </PanelContainer>
                    <ProgressBar Name="CooldownBar" MinValue="0" MaxValue="60" Value="0" MinHeight="16" />

                    <PanelContainer MinHeight="1" Margin="0 4">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#333355" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>

                    <Label Text="СЕКТОРНЫЙ ДИСК" StyleClasses="LabelBig" FontColorOverride="#00d4ff" HorizontalAlignment="Center" />
                    <Label Name="DiskStatusLabel" Text="Вставьте координатный диск" FontColorOverride="#FFaa00" HorizontalAlignment="Center" />
                    <Button Name="EjectDiskButton" Text="Извлечь диск" MinHeight="24" Visible="False" />

                    <PanelContainer MinHeight="1" Margin="0 4">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#333355" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>

                    <Label Name="SelectedGridLabel" Text="" FontColorOverride="#00FF88" HorizontalAlignment="Center" Visible="False" />
                    <Label Name="ErrorLabel" Text="" FontColorOverride="#FF4444" HorizontalAlignment="Center" Visible="False" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <!-- CENTER PANEL: Targeting -->
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="4">
            <!-- View Mode Selector -->
            <Button Name="ViewModeButton" Text="РЕЖИМ: СКАНЕР МАСС (ЛОКАЛЬНЫЙ)" MinHeight="32" HorizontalExpand="True" />
            <PanelContainer Name="ViewDropdownPanel" MinHeight="0" Visible="False">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1a1a2eFF" BorderColor="#00d4ff" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <ScrollContainer MinHeight="30" MaxHeight="200" HScrollEnabled="False">
                    <BoxContainer Name="DropdownContainer" Orientation="Vertical" Margin="4" SeparationOverride="2" />
                </ScrollContainer>
            </PanelContainer>

            <!-- Viewport: Radar -->
            <shuttles:ShuttleNavControl Name="RadarScreen"
                                        VerticalExpand="True"
                                        HorizontalExpand="True"
                                        Margin="0 2" />

            <!-- Viewport: Map -->
            <bsa:BSANavMapControl Name="MapScreen"
                                  VerticalExpand="True"
                                  HorizontalExpand="True"
                                  Margin="0 2"
                                  Visible="False" />

            <!-- Coordinate Input -->
            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1a1a2eFF" BorderColor="#00d4ff" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" Margin="6" SeparationOverride="8" VerticalAlignment="Center">
                    <Label Text="X:" FontColorOverride="#00d4ff" VerticalAlignment="Center" />
                    <LineEdit Name="CoordinateX" MinWidth="80" MaxWidth="100" PlaceHolder="0" />
                    <Label Text="Y:" FontColorOverride="#00d4ff" VerticalAlignment="Center" />
                    <LineEdit Name="CoordinateY" MinWidth="80" MaxWidth="100" PlaceHolder="0" />
                    <Control HorizontalExpand="True" />
                    <Button Name="FireButton" Text="ОГОНЬ" MinWidth="120" MinHeight="36" HorizontalAlignment="Right" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

    </BoxContainer>
</DefaultWindow>
