<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      SetSize="650 330"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalAlignment="Stretch" Margin="10">
        <!-- Блок: Скорость зарядки -->
        <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalAlignment="Stretch" Margin="2">
            <BoxContainer Orientation="Vertical" HorizontalAlignment="Stretch" Margin="4">
                <Label Text="Скорость зарядки" StyleClasses="LabelKeyText" HorizontalAlignment="Center"/>

                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="4">
                    <!-- Слайдер занимает основную часть -->
                    <Slider
                        Name="ChargeSpeedSlider"
                        HorizontalExpand="True"
                        Rounded ="true"/>

                    <!-- Метка справа (максимум) -->
                    <Label
                        Name="ChargeSpeedMaxLabel"
                        Text="100"
                        HorizontalAlignment="Right"
                        Margin="8,0,0,0"
                        StyleClasses="SliderValueLabel"/>

                </BoxContainer>

                <Label Name="ChargeSpeedValue" Text="50" HorizontalAlignment="Center"/>

                <!-- Горизонтальный контейнер с LineEdit и Button -->
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="4">
                    <!-- LineEdit занимает максимум места -->
                      <LineEdit
                        Name="ChargeSpeedLineEdit"
                        PlaceHolder="писать в ваттах"
                        HorizontalExpand="True"
                        Margin="0,0,8,0"/>

                    <!-- Кнопка справа -->
                    <Button Name="SpeedChargeConfirm"
                            Text="Подтвердить"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,0"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Блок: Максимальный заряд -->
        <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalAlignment="Stretch" Margin="2">
            <BoxContainer Orientation="Vertical" HorizontalAlignment="Stretch" Margin="4">
                <Label Text="Максимальный заряд" StyleClasses="LabelKeyText" HorizontalAlignment="Center"/>
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="4">
                    <!-- Слайдер -->
                    <Slider
                        Name="MaxChargeSlider"
                        HorizontalExpand="True"
                        Rounded ="true"/>

                    <!-- Метка справа (максимум) -->
                    <Label
                        Name="MaxChargeMaxLabel"
                        Text="200"
                        HorizontalAlignment="Right"
                        Margin="8,0,0,0"
                        StyleClasses="SliderValueLabel"/>
                </BoxContainer>
                <Label Name="LimitSellValue" Text="50" HorizontalAlignment="Center"/>

                <!-- Аналогично для второго блока -->
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="4">
                     <LineEdit
                        Name="MaxChargeLineEdit"
                        PlaceHolder="писать в ваттах"
                        HorizontalExpand="True"
                        Margin="0,4"/>

                    <Button Name="SellLimitConfirm"
                            Text="Подтвердить"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,0"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
