<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:ui="clr-namespace:Content.Client.Options.UI"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      SetSize="650 330"
                      Resizable="False">

    <BoxContainer Orientation="Vertical">
        <!-- Основной контейнер -->

        <!-- Внутри: ваш существующий код — сохраните всё, что есть -->
        <BoxContainer Name="MainContent" Orientation="Horizontal" VerticalExpand="True" Margin="4">

        </BoxContainer>

        <!-- Новая секция для регулировки скорости зарядки и максимального заряда -->
        <PanelContainer StyleClasses="BackgroundPanelDark" Margin="0 8" VerticalExpand="False">
            <BoxContainer Orientation="Horizontal">
                <!-- Левая часть: слайдеры -->
                <BoxContainer Orientation="Vertical">
                    <Label Text="Скорость зарядки" StyleClasses="LabelKeyText" />
                    <ui:OptionSlider Name="ChargeRateSlider"/>
                    <Label Name="ChargeRateValue" Text="50"/>
                </BoxContainer>
                <BoxContainer Orientation="Vertical">
                    <Label Text="Максимальный заряд" StyleClasses="LabelKeyText" />
                    <ui:OptionSlider Name="MaxChargeSlider"/>
                    <Label Name="MaxChargeValue" Text="80"/>
                </BoxContainer>

                <!-- Правая часть: поля ввода и кнопки -->
                <BoxContainer Orientation="Vertical" Margin="15,0,0,0">
                    <!-- Замените свой элемент ввода на ваш, например, LineEdit -->
                    <BoxContainer Orientation="Horizontal">
                        <!-- Юнит или название элемента для ввода, например, LineEdit -->
                        <LineEdit Name="ChargeSpeedInput" Text="50"/>
                        <Button Text="Подтвердить"/>
                    </BoxContainer>

                    <BoxContainer Orientation="Horizontal">
                        <LineEdit Name="MaxChargeInput" Text="80"/>
                        <Button Text="Подтвердить"/>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Остальной ваш существующий контент, если есть -->
        <!-- Например, футер или другие секции -->

    </BoxContainer>
</controls:FancyWindow>
