<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="Tram Controls"
                      SetSize="500 350"
                      MinSize="500 350">
    <BoxContainer Orientation="Vertical" Margin="5">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 5">
            <Label Text="Status: " StyleClasses="LabelKeyText" />
            <Label Name="StatusLabel" Text="Unknown" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 10">
            <Label Text="Location: " StyleClasses="LabelKeyText" />
            <Label Name="LocationLabel" Text="In Transit" />
        </BoxContainer>
        <PanelContainer VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="DestinationsContainer" Orientation="Vertical"
                              VerticalExpand="True"/>
            </ScrollContainer>
        </PanelContainer>
        <Button Name="SendButton"
                Text="Send Tram"
                HorizontalAlignment="Center"
                Margin="0 5 0 0"
                Disabled="True"
                MinWidth="150"/>
    </BoxContainer>
</controls:FancyWindow>
