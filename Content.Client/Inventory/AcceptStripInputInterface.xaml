<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Resizable="False"
                      MinSize="420 120">
    <BoxContainer Orientation="Vertical" Margin="10 10 10 10" HorizontalExpand="True">
        <Label Name="MessageText"
               Text="{Loc 'strippable-bound-user-interface-inserting-menu-message'}"
               Margin="0 0 0 12"
               HorizontalExpand="True"
               Align="Center"
               VAlign="Center"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
            <Button Name="AnswerCallButton"
                    Text="{Loc 'strippable-bound-user-interface-inserting-menu-yes-answer'}"
                    StyleClasses="OpenRight"
                    HorizontalExpand="True"
                    TextAlign="Center"/>
            <Button Name="EndCallButton"
                    Text="{Loc 'strippable-bound-user-interface-inserting-menu-no-answer'}"
                    StyleClasses="OpenLeft"
                    HorizontalExpand="True"
                    TextAlign="Center"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
