<DefaultWindow xmlns="https://spacestation14.io"
              Title="SYS-STATUS :: ДИАГНОСТИКА"
              SetSize="420 380"
              MinSize="420 380">
    <PanelContainer Name="MainPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="8">
            <PanelContainer Name="HeaderPanel" MinHeight="28" Margin="0 0 0 4">
                <Label Name="HeaderLabel"
                       Text=":: СОСТОЯНИЕ СИСТЕМ ШАТТЛА ::"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </PanelContainer>
            <Control Name="StatusDisplay"
                     VerticalExpand="True"
                     HorizontalExpand="True"
                     Margin="0 4" />
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
