<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Pipe Shuttle Console"
    MinSize="300 200"
    SetSize="300 200">
    <BoxContainer VerticalExpand="True" Orientation="Vertical" Margin="10">
        <Label Text="Select destination:" StyleClasses="LabelSubText" Margin="0 0 0 5"/>
        <ItemList Name="StopList" VerticalExpand="True" Margin="0 0 0 10"/>
        <Label Name="StatusLabel" Text="Status: Idle" StyleClasses="LabelSubText" Margin="0 0 0 5"/>
        <Button Name="CallButton" Text="Call Shuttle" HorizontalAlignment="Center" Disabled="True"/>
    </BoxContainer>
</controls:FancyWindow>
